# See ENVIRONMENT.md for full documentation of every variable below.
# Never commit a real .env file. Only placeholders belong here.

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://ilmai.store
NEXT_PUBLIC_STORE_URL=https://ilmai.store
NEXT_PUBLIC_ILMAI_STUDY_URL=https://ilmai.study
NODE_ENV=development

# Server-to-server purchase attribution callback.
ILMAI_STUDY_AD_CONVERSION_URL=
ILMAI_STUDY_AD_CONVERSION_SECRET=

# Daily USD/PKR exchange-rate job.
EXCHANGE_RATE_API_KEY=
CRON_SECRET=

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend ───────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=store@ilmai.study

# ── Backblaze B2 (S3-compatible) ────────────────────────────
B2_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_PUBLIC_MEDIA_PREFIX=media/
B2_PRIVATE_DOWNLOADS_PREFIX=private/

# ── Paddle ───────────────────────────────────────────────────
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300

# ── Admin / Misc ─────────────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL=
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR

# ── ilmai.study account handoff ─────────────────────────────
# Same value must be set on ilmai.study's deployment (STORE_HANDOFF_SECRET
# there) — verifies the short-lived token /auth/handoff receives so a
# logged-in study user lands here already signed into their linked account.
STORE_HANDOFF_SECRET=
